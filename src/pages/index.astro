---
import Base from '../layouts/Base.astro';
const recentNotes = [
  {
    slug: 'sva-cheat-sheet',
    title: 'SVA cheat sheet',
    description: 'Quick reference for SystemVerilog Assertion syntax — sequences, properties, clocking, and cover/assume.',
    tags: ['SVA', 'SystemVerilog'],
  },
];
const recentWriting = [
  {
    slug: 'fv-project-walkthrough',
    title: 'A complete formal verification project, start to finish',
    description: 'From microarchitecture spec to coverage closure — how a real FV engagement is structured and executed.',
    tags: ['FV methodology', 'JasperGold'],
  },
];
---

<Base title="Home">
  <div class="container">
    <section class="hero">
      <h1>Formal Verification Engineer</h1>
      <p class="hero-sub">
        I work on hardware IP verification at Intel — writing SVA properties,
        running JasperGold proof campaigns, and closing coverage on digital designs.
        This site is where I publish notes, references, and longer pieces on formal methods.
      </p>
      <div class="hero-links">
        <a href="/about">About me</a>
        <span class="sep">·</span>
        <a href="https://github.com/phd208" target="_blank" rel="noopener">GitHub</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/pedrodornas" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </section>

    <section class="index-section">
      <div class="section-header">
        <h2 class="section-title">Notes</h2>
        <a href="/notes" class="section-more">All notes →</a>
      </div>
      <div class="card-list">
        {recentNotes.map(n => (
          <a href={`/notes/${n.slug}`} class="entry-card">
            <div class="entry-title">{n.title}</div>
            <div class="entry-desc">{n.description}</div>
            <div class="entry-tags">
              {n.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="index-section">
      <div class="section-header">
        <h2 class="section-title">Writing</h2>
        <a href="/writing" class="section-more">All writing →</a>
      </div>
      <div class="card-list">
        {recentWriting.map(w => (
          <a href={`/writing/${w.slug}`} class="entry-card">
            <div class="entry-title">{w.title}</div>
            <div class="entry-desc">{w.description}</div>
            <div class="entry-tags">
              {w.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
.hero {
  padding: 3.5rem 0 3rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 2.5rem;
}
.hero h1 {
  font-size: 2rem;
  margin-bottom: 0.875rem;
}
.hero-sub {
  color: var(--color-muted);
  font-size: 1rem;
  max-width: 560px;
  margin-bottom: 1.25rem;
  line-height: 1.75;
}
.hero-links {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  font-size: 0.9rem;
}
.sep { color: var(--color-border); }

.index-section { margin-bottom: 3rem; }

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.section-title {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
  margin: 0;
}
.section-more {
  font-size: 0.825rem;
  color: var(--color-muted);
}
.section-more:hover { color: var(--color-text); }

.card-list { display: flex; flex-direction: column; gap: 1px; }

.entry-card {
  display: block;
  padding: 1rem 0;
  border-bottom: 1px solid var(--color-border);
  text-decoration: none;
  color: inherit;
  transition: background 0.1s;
}
.entry-card:first-child { border-top: 1px solid var(--color-border); }
.entry-card:hover { text-decoration: none; }
.entry-card:hover .entry-title { color: var(--color-accent); }

.entry-title {
  font-size: 0.975rem;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 0.3rem;
  transition: color 0.15s;
}
.entry-desc {
  font-size: 0.875rem;
  color: var(--color-muted);
  margin-bottom: 0.5rem;
  line-height: 1.5;
}
.entry-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
</style>
