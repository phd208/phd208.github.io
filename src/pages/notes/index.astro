---
import Base from '../layouts/Base.astro';
const notes = [
  {
    slug: 'sva-cheat-sheet',
    title: 'SVA cheat sheet',
    description: 'Quick reference for SystemVerilog Assertion syntax — sequences, properties, clocking, cover, and assume.',
    tags: ['SVA', 'SystemVerilog'],
    date: '2024',
  },
];
---

<Base title="Notes" description="Short reference pages on formal verification, SVA, and JasperGold">
  <div class="container">
    <div class="page-header">
      <h1>Notes</h1>
      <p class="page-sub">Short reference pages — meant to be bookmarked and returned to.</p>
    </div>

    <div class="entry-list">
      {notes.map(n => (
        <a href={`/notes/${n.slug}`} class="entry-card">
          <div class="entry-main">
            <div class="entry-title">{n.title}</div>
            <div class="entry-desc">{n.description}</div>
          </div>
          <div class="entry-meta">
            <div class="entry-tags">
              {n.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
.page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
h1 { margin-bottom: 0.5rem; }
.page-sub { color: var(--color-muted); font-size: 0.95rem; margin: 0; }
.entry-list { display: flex; flex-direction: column; }
.entry-card {
  display: block;
  padding: 1.125rem 0;
  border-bottom: 1px solid var(--color-border);
  text-decoration: none;
  color: inherit;
}
.entry-card:hover .entry-title { color: var(--color-accent); }
.entry-title { font-size: 0.975rem; font-weight: 500; color: var(--color-text); margin-bottom: 0.3rem; transition: color 0.15s; }
.entry-desc { font-size: 0.875rem; color: var(--color-muted); line-height: 1.5; margin-bottom: 0.6rem; }
.entry-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
</style>
