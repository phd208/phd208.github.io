---
import Base from '../../layouts/Base.astro';
const articles = [
  {
    slug: 'fv-project-walkthrough',
    title: 'A complete formal verification project, start to finish',
    description: 'From microarchitecture spec to coverage closure — how a real FV engagement is structured and executed.',
    tags: ['FV methodology', 'JasperGold'],
    date: '2024',
  },
];
---

<Base title="Writing" description="Long-form articles on formal verification and hardware engineering">
  <div class="container">
    <div class="page-header">
      <h1>Writing</h1>
      <p class="page-sub">Longer pieces — project write-ups, methodology deep-dives, and technical explorations.</p>
    </div>

    <div class="entry-list">
      {articles.map(a => (
        <a href={`/writing/${a.slug}`} class="entry-card">
          <div class="entry-title">{a.title}</div>
          <div class="entry-desc">{a.description}</div>
          <div class="entry-tags">
            {a.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
.page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
h1 { margin-bottom: 0.5rem; }
.page-sub { color: var(--color-muted); font-size: 0.95rem; margin: 0; }
.entry-list { display: flex; flex-direction: column; }
.entry-card {
  display: block;
  padding: 1.125rem 0;
  border-bottom: 1px solid var(--color-border);
  text-decoration: none;
  color: inherit;
}
.entry-card:hover .entry-title { color: var(--color-accent); }
.entry-title { font-size: 0.975rem; font-weight: 500; color: var(--color-text); margin-bottom: 0.3rem; transition: color 0.15s; }
.entry-desc { font-size: 0.875rem; color: var(--color-muted); line-height: 1.5; margin-bottom: 0.6rem; }
.entry-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
</style>
