---
import '../styles/global.css';
const { title = 'Pedro Dornas', description = 'Formal Verification Engineer' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/',         label: 'Home'     },
  { href: '/about',    label: 'About'    },
  { href: '/notes',    label: 'Notes'    },
  { href: '/writing',  label: 'Writing'  },
  { href: '/projects', label: 'Projects' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — Pedro Dornas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="container--wide header-inner">
      <a href="/" class="wordmark">Pedro Dornas</a>
      <nav aria-label="Site navigation">
        {nav.map(({ href, label }) => (
          <a
            href={href}
            class:list={['nav-link', { active: currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container--wide footer-inner">
      <span class="footer-name">Pedro Dornas</span>
      <span class="footer-muted">Formal Verification Engineer · Vancouver, BC</span>
      <div class="footer-links">
        <a href="https://github.com/phd208" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/pedrodornas" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
.site-header {
  border-bottom: 1px solid var(--color-border);
  padding: 0.875rem 0;
  position: sticky;
  top: 0;
  background: var(--color-bg);
  z-index: 10;
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
}
.wordmark {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--color-text);
  white-space: nowrap;
  text-decoration: none;
}
.wordmark:hover { text-decoration: none; }
nav {
  display: flex;
  gap: 0.25rem;
  flex-wrap: wrap;
}
.nav-link {
  font-size: 0.875rem;
  color: var(--color-muted);
  padding: 0.3rem 0.65rem;
  border-radius: var(--radius-sm);
  transition: color 0.15s, background 0.15s;
  text-decoration: none;
}
.nav-link:hover {
  color: var(--color-text);
  background: var(--color-bg-subtle);
  text-decoration: none;
}
.nav-link.active {
  color: var(--color-text);
  font-weight: 500;
}

.site-footer {
  border-top: 1px solid var(--color-border);
  margin-top: 5rem;
  padding: 1.5rem 0;
}
.footer-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  font-size: 0.8rem;
}
.footer-name { font-weight: 500; color: var(--color-text); }
.footer-muted { color: var(--color-muted); flex: 1; }
.footer-links { display: flex; gap: 1rem; }
.footer-links a { color: var(--color-muted); font-size: 0.8rem; }
.footer-links a:hover { color: var(--color-text); }
</style>
